# Скопируйте в .env и заполните. Файл .env не коммитьте: в нём токен бота.

# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую: им доступны /grant и /stats.
# Свой ID можно узнать у любого бота вроде @userinfobot.
ADMIN_IDS=

# Часовой пояс по умолчанию и час отправки напоминаний (по местному времени пользователя)
DEFAULT_TZ=Asia/Kuala_Lumpur
SEND_HOUR=9

# Тарифы: сколько документов бесплатно и в Premium
FREE_PROFILES=1
PREMIUM_PROFILES=8

# 1: счётчик дней для налогов только в Premium. 0: бесплатно для всех (удобно на этапе проверки спроса)
TAX_TRACKER_PREMIUM=1

# Что показывать в /premium, пока нет автоматической оплаты (например, ваш @username)
PREMIUM_CONTACT=

# Путь к базе SQLite
DB_PATH=relocbot.sqlite3
